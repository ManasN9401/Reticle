{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reticle agent v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "runtime",
    "entrypoint"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "runtime": {
      "enum": [
        "python",
        "binary",
        "go"
      ]
    },
    "entrypoint": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.read",
          "workspace.write",
          "network.public",
          "process.container",
          "process.native",
          "memory.execution",
          "graph.delegate",
          "image.local",
          "rag.local",
          "cloud.plan",
          "cloud.apply",
          "security.active",
          "gpu.use"
        ]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "event"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
