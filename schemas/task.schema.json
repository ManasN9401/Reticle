{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reticle task v1",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "execution": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "modality": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "data": {}
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "memory_metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/memoryReference"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "memoryReference": {
      "type": "object",
      "required": ["scope", "scope_id", "version"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": ["global", "workflow", "execution", "agent"]
        },
        "scope_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capability": {
      "enum": [
        "workspace.read",
        "workspace.write",
        "network.public",
        "process.container",
        "process.native",
        "memory.execution",
        "graph.delegate",
        "image.local",
        "rag.local",
        "cloud.plan",
        "cloud.apply",
        "security.active",
        "gpu.use"
      ]
    }
  },
  "additionalProperties": false
}
