# Set only the providers you use. Never commit real values.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=

# Optional default for examples that do not declare a routed model.
RETICLE_DEFAULT_MODEL=

# Optional local endpoints; these are configuration, not secrets.
OLLAMA_HOST=http://localhost:11434
COMFYUI_HOST=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
LITELLM_DROP_PARAMS=true

# Optional adapters/experiments: provide only when that integration needs them.
HF_TOKEN=
WANDB_API_KEY=
# Cloud credentials should use a dedicated scoped profile/credential store.
# Do not place unrestricted cloud account keys in the generic worker environment.

# AWS operator/explicit cloud adapter configuration (see docs/environment.md).
# Prefer an AWS CLI SSO profile, or an IAM role when running on EC2.
# AWS_PROFILE=reticle-dev
# AWS_REGION=eu-west-2
# AWS_DEFAULT_REGION=eu-west-2
# Alternative: temporary credentials supplied by your credential source.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# These variables do not enable EC2 provisioning or get forwarded to workers.

# Shared-memory lifecycle and restart recovery.
# RETICLE_MEMORY_PERSISTENCE=true
# RETICLE_MEMORY_MAX_ENTRIES=10000
# RETICLE_MEMORY_MAX_MIB=16
# RETICLE_EXECUTION_MEMORY_TTL_HOURS=24
# RETICLE_ARTIFACT_MAX_VERSIONS=100
